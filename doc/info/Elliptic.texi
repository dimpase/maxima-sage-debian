@anchor{inverse_jacobi_dn}
@deffn {Function} inverse_jacobi_dn (@var{u}, @var{m})
The inverse of the Jacobian elliptic function 
@html
\({\rm
dn}(u,m).\)
@end html
@ifinfo
@math{dn(u,m).}
@end ifinfo
@iftex
@math{{\rm
dn}(u,m).}
@end iftex 
For 
@html
\(\sqrt{1-m}\le u \le 1,\)
@end html
@ifinfo
@math{sqrt(1-m) <= u <= 1,}
@end ifinfo
@iftex
@math{\sqrt{1-m}\le u \le 1,}
@end iftex 
it can also be written (@urldlmf{22.15.E14}):
@html
$$
{\rm inverse\_jacobi\_dn}(u, m) = \int_u^1 {dt\over \sqrt{(1-t^2)(t^2-(1-m))}}
$$
@end html
@ifinfo
@example
                                1
                               /
                               [               1
     inverse_jacobi_dn(u, m) = I  --------------------------- dt
                               ]             2    2
                               /  sqrt((1 - t ) (t  + m - 1))
                                u
@end example

@end ifinfo
@tex
$${\rm inverse\_jacobi\_dn}(u, m) = \int_u^1 {dt\over \sqrt{(1-t^2)(t^2-(1-m))}}$$
@end tex



@opencatbox{Categories:}
@category{Elliptic functions}
@closecatbox
@end deffn

